{
  "name": "pi-dspy-gepa-workflows",
  "version": "0.1.0",
  "description": "Continuous Pi coding campaigns driven by DSPy and improved through GEPA",
  "keywords": [
    "pi-package"
  ],
  "homepage": "https://github.com/Vzlentin/pi-dspy-gepa-workflows#readme",
  "bugs": {
    "url": "https://github.com/Vzlentin/pi-dspy-gepa-workflows/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vzlentin/pi-dspy-gepa-workflows.git"
  },
  "bin": {
    "campaign": "dist/launcher/cli.js"
  },
  "files": [
    "dist",
    "prompts",
    "python/pi_dspy_gepa/**/*.py",
    "fixtures/historical",
    "docs",
    "pyproject.toml",
    "uv.lock",
    ".python-version",
    "README.md",
    "LICENSE",
    "scripts/prepare.mjs"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/campaign/index.d.ts",
      "default": "./dist/campaign/index.js"
    },
    "./runtime": {
      "types": "./dist/runtime/index.d.ts",
      "default": "./dist/runtime/index.js"
    },
    "./learning": {
      "types": "./dist/learning/index.d.ts",
      "default": "./dist/learning/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run build && npm run test:coverage && npm run check:python",
    "check:python": "uv run --frozen ruff format --check python && uv run --frozen ruff check python && npm run test:python",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "lint": "oxlint --deny-warnings src test",
    "prepare": "node scripts/prepare.mjs",
    "test": "vitest run",
    "test:acceptance": "vitest run --config vitest.acceptance.config.ts",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:python": "uv run --frozen pytest python/tests",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "better-sqlite3": "13.0.2",
    "canonicalize": "4.0.0",
    "jiti": "2.7.0"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.84.4",
    "@earendil-works/pi-coding-agent": "0.84.4",
    "@earendil-works/pi-tui": "0.84.4",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.1",
    "@vitest/coverage-istanbul": "^4.1.10",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.74.0",
    "tsx": "^4.23.1",
    "typebox": "1.3.7",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "0.84.4",
    "@earendil-works/pi-coding-agent": "0.84.4",
    "@earendil-works/pi-tui": "0.84.4",
    "typebox": "1.3.7"
  },
  "engines": {
    "node": ">=22.18"
  }
}
